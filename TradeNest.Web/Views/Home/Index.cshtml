@{
    ViewData["Title"] = "Home Page";
}

<div class="container-lg d-flex flex-column gap-5 py-3 mt-5">
    
    <div class="row align-items-center justify-content-between pt-5 py-md-5 site-sections-bg shadow rounded-3">
        <div class="col text-center text-md-start ms-0 ms-md-4">
            <h1 class="display-5 fw-bold text-navy">
                Welcome to <span class="text-teal">TradeNest</span>
            </h1>

            <p class="lead text-muted">
                Buy, sell, and trade smarter — all in one trusted marketplace.
            </p>

            <div class="d-flex gap-3 mt-4 justify-content-center justify-content-md-start">
                <a class="btn btn-teal btn-lg px-4"
                   asp-controller="Products" asp-action="Index">Shop Now</a>
                <a class="btn btn-outline-teal btn-lg px-4"
                   asp-controller="Products" asp-action="Create">Become a Seller</a>
            </div>
        </div>

        <div class="col-md-5">
            <img src="~/images/tradenest-logo/tradenest-logo.png" alt="TradeNest"
                 class="img-fluid"/>
        </div>
    </div>

    <div class="row px-3">

        <div class="col-md-4">
            <div class="card h-100 site-sections-bg shadow border-0 rounded-3">
                <div class="card-body text-center">
                    <h4 class="card-title text-navy fw-semibold">
                        <span class="text-teal">Hot Right Now</span>
                    </h4>
                    <p class="card-text text-muted">
                        See what is most popular right now.
                    </p>
                </div>
                <div class="card-footer d-flex justify-content-center">
                    <a asp-controller="Products" asp-action="BestSellers"
                       class="btn btn-teal">Go Now</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 site-sections-bg shadow border-0 rounded-3">
                <div class="card-body text-center">
                    <h4 class="card-title text-navy fw-semibold">
                        <span class="text-teal">See Categories</span>
                    </h4>
                    <p class="card-text text-muted">
                        Explore a wide range of product categories.
                    </p>
                </div>
                <div class="card-footer d-flex justify-content-center">
                    <a class="btn btn-teal"
                       asp-controller="Categories" asp-action="Index">Go Now</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 site-sections-bg shadow border-0 rounded-3">
                <div class="card-body text-center">
                    <h4 class="card-title text-navy fw-semibold">
                        <span class="text-teal">Have Something To Sell?</span>
                    </h4>
                    <p class="card-text text-muted">
                        See how we can help you.
                    </p>
                </div>
                <div class="card-footer d-flex justify-content-center">
                    <a class="btn btn-teal"
                       asp-controller="Products" asp-action="Create">Go Now</a>
                </div>
            </div>
        </div>

    </div>

</div>
