@{
    ViewData["Title"] = "Privacy Policy";
    DateTime currentDate = DateTime.UtcNow.Date;
}

<div class="main-container container mx-auto px-3 my-5 d-flex justify-content-center flex-column">
  <h1 class="display-5">@ViewData["Title"]</h1>
  <p><strong>Last updated:</strong> @currentDate</p>

  <section>
    <h2>1. Introduction</h2>
    <p>This Privacy Policy describes how this application collects, uses, and protects user information.</p>
  </section>

  <section>
    <h2>2. Information We Collect</h2>
    <ul>
      <li>Account information (such as username and email address)</li>
      <li>Encrypted or hashed authentication credentials</li>
      <li>Session and authentication data</li>
      <li>Essential cookies required for system functionality</li>
    </ul>
  </section>

  <section>
    <h2>3. How We Use Information</h2>
    <p>Collected information is used solely to:</p>
    <ul>
      <li>Provide account authentication and management</li>
      <li>Maintain secure user sessions</li>
      <li>Ensure proper functionality and security of the application</li>
    </ul>
    <p>We do not sell, rent, or share personal information with third parties.</p>
  </section>

  <section>
    <h2>4. Cookies</h2>
    <p>This application uses essential cookies for authentication and session management. These cookies are required for the system to function properly and are not used for advertising or tracking purposes.</p>
  </section>

  <section>
    <h2>5. Data Security</h2>
    <p>Reasonable technical and organizational measures are implemented to protect user data against unauthorized access, alteration, disclosure, or destruction.</p>
  </section>

  <section>
    <h2>6. Data Retention</h2>
    <p>User data is retained only as long as necessary to maintain account functionality and system integrity.</p>
  </section>

  <section>
    <h2>7. User Rights</h2>
    <p>Users may request access to, correction of, or deletion of their account information by contacting the application administrator.</p>
  </section>
</div>