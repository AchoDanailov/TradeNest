@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@using TradeNest.Data.Models

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link nav-link-border-radius-hover-effect-dark text-light" asp-area="Identity"
           asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
               asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link nav-link-border-radius-hover-effect-dark btn btn-link text-light">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link nav-link-border-radius-hover-effect-dark text-light" asp-area="Identity"
           asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link nav-link-border-radius-hover-effect-dark text-light" asp-area="Identity"
           asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
