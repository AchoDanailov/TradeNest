<div class="d-flex flex-column align-items-center">
    <label for="searchInput" class="form-label text-navy text-center">
        Search for everything
    </label>
    <form method="get" asp-controller="Products" asp-action="Index" id="searchForm">
        <div class="input-group">
            <input name="search" type="search" id="searchInput"
                   class="form-control" placeholder="Search..." 
                   aria-label="Search" />
            <button class="btn btn-outline-teal" type="submit">Search</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/searchFormValidator.js" asp-append-version="true"></script>
}