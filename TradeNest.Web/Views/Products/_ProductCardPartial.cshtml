@model ProductViewModel

<div class="card h-100 shadow d-flex flex-row" style="max-height: 190px">
    <div class="card-img-container ms-2 mt-1"> 
        <img src="@(Model.FrontImageUrl ?? DefaultProductImageUrl)"
             class="card-img-left" loading="lazy"
             alt="@Model.Name" />
    </div>
    <div class="card-body d-flex flex-column justify-content-between p-3">
        <div>
            @if (this.Model.Name.Length > 20)
            {
                <h5 class="d-md-none card-title mb-1 text-truncate">@Model.Name.Substring(0, 15)...</h5>
            }
            else
            {
                <h5 class="d-md-none card-title mb-1">@Model.Name</h5>
            }
            <h5 class="d-none d-md-block card-title mb-1">@Model.Name</h5>
            <h6 class="card-subtitle text-muted">@this.Model.CategoryName</h6>
        </div>
        <div class="mt-2 h5 text-success">
            €@this.Model.SellingPrice.ToString(PricesFormat)
        </div>
        <div class="d-flex justify-content-end gap-2 mt-2">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@this.Model.Id"
               class="btn btn-teal">Details</a>
        </div>
    </div>
</div>
