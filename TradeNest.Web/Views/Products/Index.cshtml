@model CatalogProductsAndCategoriesViewModel
@{
    ViewData["Title"] = "Catalog";
}

<div class="container-lg pt-3">
    <div class="row d-flex flex-row gap-1 my-2 align-items-center">
        <div class="text-center text-md-start ms-md-2 col-md-4">
            <div class="col">
                <h2 class="display-2 text-teal">@ViewData["Title"]</h2>
            </div>
        </div>
        <div class="col d-md-none">
            <div class="btn-group">
                @*TODO: Add action*@
                <a type="button" asp-controller="Categories" asp-action="Index"
                   class="btn btn-teal">All Categories</a>
                <button type="button" class="btn btn-teal dropdown-toggle dropdown-toggle-split"
                        data-bs-toggle="dropdown" aria-expanded="false"></button>
                <ul class="dropdown-menu">
                    @foreach (string category in this.Model.CategoriesNames)
                    {
                        <li class="nav-item">
                            <a asp-controller="Products"
                               asp-action="Index"
                               asp-route-category="@category"
                               class="dropdown-item">@category</a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <partial name="_SearchFormPartial" />
    </div>

    <div class="row d-flex gap-1">
        <div class="col-md-3 col-xl-2 nav navbar navbar-nav-scroll d-none d-md-flex site-sections-bg border rounded-3 shadow justify-content-center align-content-start flex-grow-0">
            <a asp-controller="Products" asp-action="Index">
                <h5 class="text-navy pb-1 border-bottom">All Categories</h5>
            </a>
            <ul class="d-flex flex-column justify-content-center text-center gap-1">
                @foreach (string category in this.Model.CategoriesNames)
                {
                    <li class="nav-item">
                        <a asp-controller="Products" asp-action="Index" asp-route-category="@category"
                           class="nav-link">@category</a>
                    </li>
                }
            </ul>
        </div>

        <div class="col d-flex flex-column gap-1">
            @if (!this.Model.Products.Any())
            {
                if (!this.Model.IsSearchResultSet)
                {
                    <div class="row p-5 site-sections-bg shadow rounded-3 d-flex justify-content-center gap-2">
                        <h4 class="text-navy display-4 text-center">No products are available at the moment</h4>
                        <a class="btn btn-teal btn-lg px-4 mx-auto w-auto"
                           asp-controller="Products" asp-action="Create">Be The First To Sell Your Products</a>
                    </div>
                }
                else
                {
                    <div class="row p-5 site-sections-bg shadow rounded-3 d-flex justify-content-center gap-2">
                        <h4 class="text-navy display-4 text-center">No matches found</h4>
                    </div>
                }
            }
            else
            {
                @foreach (ProductViewModel product in this.Model.Products)
                {
                    <partial name="_ProductCardPartial" model="@product"/>
                }
            }
        </div>
    </div>
</div>
