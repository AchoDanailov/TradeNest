@model ProductDetailsViewModel
@{
    ViewData["Title"] = "Product details";
    string productModificationErrorMessage = TempData["ProductModificationErrorMessage"] as string 
                                          ?? string.Empty;
}

<div class="container-lg pt-4">
    @if (!string.IsNullOrEmpty(productModificationErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            @productModificationErrorMessage
        </div>
    }
    <div class="row d-none d-md-flex flex-column justify-content-center mb-4">
        <partial name="_SearchFormPartial" />
        <div class="mt-3 mt-md-0">
            <partial name="_BackToCatalogButtonPartial" />
        </div>
    </div>
    <div class="row d-md-none d-flex flex-column justify-content-center mb-4">
        <div class="mb-3">
            <partial name="_BackToCatalogButtonPartial"/>
        </div>
        <partial name="_SearchFormPartial"/>
    </div>

    <div class="row d-flex flex-row gap-4 align-items-start">
        <div class="col d-flex flex-column align-items-center">
            <div class="product-image-wrapper rounded-3 site-sections-bg border shadow mb-3">
                <img src="@Model.FrontImageUrl"
                     alt="@Model.Name"
                     class="img-fluid product-main-image"/>
            </div>

            <div class="d-flex gap-2">
                @foreach (string imgUrl in this.Model.ImagesUrls)
                {
                    <img src="@imgUrl" class="product-thumb rounded border" alt="Thumbnail"/>
                }
            </div>
        </div>

        <div class="col-md-4 col-xl-4 text-center d-flex flex-column gap-1 site-sections-bg justify-content-center align-items-center flex-grow-0">
            @if (!this.Model.IsEnabled && this.User.Identity?.Name != this.Model.Owner)
            {
                <p class="text-danger text-center pb-0 mt-2 mb-0">Currently not available</p>
            }
            <h4 class="text-navy fw-bold py-2 border-2 border-bottom">@this.Model.Name</h4>
            <p class="text-navy text-center fw-bold border-2 border-bottom">@this.Model.Owner</p>
            <p class="text-navy text-center fw-bold border-2 border-bottom">€@this.Model.SellingPrice</p>
            @if (this.User?.Identity?.Name == this.Model.Owner)
            {
                if (this.Model.IsEnabled)
                {
                    <div class="rounded-pill p-2 site-sections-bg-teal text-light mb-2">Enabled</div>
                }
                else
                {
                    <div class="rounded-pill p-2 bg-danger text-light mb-2">Disabled</div>
                }
            }

            <div class="d-flex flex-column row align-items-center">
                <label for="quantityInput" class="form-label text-navy mb-0">Quantity: </label>
                @if (this.Model.IsEnabled == false || this.User?.Identity?.Name == this.Model.Owner)
                {
                    <input id="quantityInput" class="form-control-sm" type="number"
                           value=0 aria-label="Quantity" disabled/>
                }
                else
                {
                    @*TODO: Add to req*@
                    <input id="quantityInput" class="form-control-sm" type="number"
                           value=1 aria-label="Quantity"/>
                }
                <p class="text-navy text-muted mt-2">@this.Model.QuantityInStock available</p>
            </div>

            <div class="btn-group-vertical align-items-stretch flex-grow-1">
                @if (this.User?.Identity?.Name == this.Model.Owner)
                {
                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@this.Model.Id"
                       class="rounded-pill btn-teal p-2">Make Changes</a>
                    <button type="button" class="rounded-pill btn btn-outline-danger mt-2 p-2"
                            data-bs-toggle="modal" data-bs-target="#deleteModal">Delete</button>
                    
                    <div class="modal fade" id="deleteModal" data-bs-backdrop="static"
                         data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" 
                         aria-hidden="true">
                      <div class="modal-dialog">
                        <div class="modal-content">
                          <div class="modal-header">
                              <h1 class="modal-title fs-5" id="staticBackdropLabel">
                                  Confirm Deletion
                              </h1>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" 
                                      aria-label="Close"></button>
                          </div>
                          <div class="modal-body">
                              Are you sure you want to delete @Model.Name from your inventory?
                          </div>
                          <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" 
                                      data-bs-dismiss="modal">No</button>
                              <form method="post" asp-controller="Products"
                                    asp-action="Delete" asp-route-id="@Model.Id">
                                  <input type="hidden" name="returnUrl" 
                                         value="@Url.Action("Details", controller: "Products")"/>
                                  <button type="submit" class="btn btn-danger">Yes</button>
                              </form>
                          </div>
                        </div>
                      </div>
                    </div>
                }
                else
                {
                    if (this.Model.IsEnabled)
                    {
                        <a class="rounded-pill btn-teal p-2">Order Now</a>
                    }
                    else
                    {
                        <p class="rounded-pill bg-secondary p-2 text-light">Sorry can't order right now</p>
                    }
                }
            </div>

            <div class="d-flex flex-column mt-4 flex-grow-1 w-100">
                <h4 class="text-navy py-2 border-2 border-bottom">Description</h4>
                <p class="text-navy mt-2 text-start mx-3 overflow-auto flex-grow-1">
                    @this.Model.Description
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/prodDetailsFrontImageSwapper.js" asp-append-version="true"></script>
}
