@model ProductDetailsViewModel
@{
    ViewData["Title"] = "Product details";
}

<div class="container-lg pt-4">
    
    <partial name="_StatusNotificationPartial" />
    
    <div class="row d-none d-md-flex flex-column justify-content-center mb-4">
        <partial name="_SearchFormPartial"/>
        
        <div class="mt-3 mt-md-0">
            <partial name="_BackToCatalogButtonPartial"/>
        </div>
    </div>
    
    <div class="row d-md-none d-flex flex-column justify-content-center mb-4">
        <div class="mb-3">
            <partial name="_BackToCatalogButtonPartial"/>
        </div>
        
        <partial name="_SearchFormPartial"/>
    </div>

    <div class="row d-flex gap-4 align-items-start">
        
        <div class="col d-flex flex-column align-items-center">
            <div class="product-image-wrapper site-sections-bg rounded-3 border shadow mb-3">
                <img src="@(Model.FrontImageUrl ?? DefaultProductImageUrl)" alt="@this.Model.Name"
                     class="img-fluid product-main-image"/>
            </div>

            <div class="d-flex gap-2">
                @foreach (string imgUrl in this.Model.ImagesUrls)
                {
                    <img src="@imgUrl" class="product-thumb rounded border" alt="Thumbnail" />
                }
            </div>
        </div>

        <div class="col-md-4 text-center d-flex flex-column gap-1 site-sections-bg align-items-center">
            @if (!this.Model.IsEnabled && !this.Model.IsOwner)
            {
                <p class="text-danger text-center pb-0 mt-2 mb-0">
                    Currently not available
                </p>
            }
            <h4 class="text-navy fw-bold py-2 border-2 border-bottom">
                @Model.Name
            </h4>
            <p class="text-navy text-center fw-bold border-2 border-bottom">
                @Model.OwnerName
            </p>
            <p class="text-navy text-center fw-bold border-2 border-bottom">
                €@Model.SellingPrice.ToString(PricesFormat)
            </p>
            @if (this.Model.IsOwner)
            {
                if (this.Model.IsEnabled)
                {
                    <div class="rounded-pill p-2 site-sections-bg-teal text-light mb-2">
                        Enabled
                    </div>
                }
                else
                {
                    <div class="rounded-pill p-2 bg-danger text-light mb-2">Disabled</div>
                }
            }

            <div class="d-flex flex-column align-items-center">
                <label for="quantityInput" class="form-label text-navy mb-0">
                    Quantity:
                </label>
                @if (User?.Identity?.IsAuthenticated == false)
                {
                    <input id="quantityInput" class="form-control-sm" type="number"
                           value="0" aria-label="Quantity" disabled />

                    <p class="text-navy text-muted mt-2">
                        @Model.QuantityInStock available
                    </p>

                    @if (this.Model.IsEnabled)
                    {
                        <div class="d-flex flex-column mx-auto w-75">
                            <button class="rounded-pill bg-secondary p-2 text-light" disabled>
                                Add To Order
                            </button>

                            <a asp-area="Identity" asp-page="/Account/Login"
                               asp-route-returnUrl="@Url.Action("Details", "Products", new { id = this.Model.Id })"
                               class="rounded-pill btn-teal p-2 mt-2">
                                Login
                            </a>

                            <small>
                                Don’t have an account?
                                <a asp-area="Identity" asp-page="/Account/Register"
                                   asp-route-returnUrl="@Url.Action("Details", "Products", new { id = this.Model.Id })"
                                   class="text-decoration-underline">
                                    Register here
                                </a>
                            </small>
                        </div>
                    }
                    else
                    {
                        <p class="rounded-pill bg-secondary p-2 text-light">
                            Sorry, can’t order right now
                        </p>
                    }
                }
                else
                {
                    if (!this.Model.IsEnabled || this.Model.IsOwner)
                    {
                        <input id="quantityInput" class="form-control-sm" type="number"
                               value="0" aria-label="Quantity" disabled />

                        <p class="text-navy text-muted mt-2">
                            @Model.QuantityInStock available
                        </p>

                        @if (!this.Model.IsOwner)
                        {
                            <p class="rounded-pill bg-secondary p-2 text-light">
                                Sorry, can’t order right now
                            </p>
                        }
                    }
                    else
                    {
                        <form method="post" asp-controller="Orders" asp-action="AddProduct"
                              asp-route-id="@Model.Id" id="add-to-order-form">

                        <input type="hidden" name="id" value="@Model.Id" />
                            
                            <input type="hidden" name="returnUrl"
                                   value="@Url.Action("Details", "Products", new { id = this.Model.Id })" />

                            <input type="number" name="quantity" id="quantityInput"
                                   class="form-control-sm" value="1" aria-label="Quantity" />

                            <div class="text-danger" id="prod-qty-validation">
                                <small></small>
                            </div>

                            <p id="available-quantity-ui" class="text-navy text-muted mt-2">
                                @Model.QuantityInStock available
                            </p>

                            <button type="submit" id="add-to-order-btn"
                                    class="rounded-pill btn-teal p-2">
                                Add To Order
                            </button>
                        </form>
                    }
                }
            </div>

            <div class="btn-group-vertical align-items-stretch">
                @if (this.Model.IsOwner)
                {
                    <a asp-controller="Products" asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="rounded-pill btn-teal p-2">Make Changes</a>
                    <button type="button"
                            class="rounded-pill btn btn-outline-danger mt-2 p-2"
                            data-bs-toggle="modal" data-bs-target="#deleteModal">
                        Delete
                    </button>

                    <div class="modal fade" id="deleteModal" data-bs-backdrop="static"
                         data-bs-keyboard="false" tabindex="-1" 
                         aria-labelledby="staticBackdropLabel"
                         aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5" id="staticBackdropLabel">
                                        Confirm Deletion
                                    </h1>
                                    <button type="button" class="btn-close" 
                                            data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Are you sure you want to delete @Model.Name from your inventory?
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary"
                                            data-bs-dismiss="modal">No</button>
                                    
                                    <form method="post" asp-controller="Products"
                                          asp-action="Delete" asp-route-id="@Model.Id">
                                        <input type="hidden" name="returnUrl"
                                               value="@Url.Action("Details", controller: "Products")"/>
                                        <button type="submit" class="btn btn-danger">
                                            Yes
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex flex-column mt-4 flex-grow-1 w-100">
                <h4 class="text-navy py-2 border-2 border-bottom">Description</h4>
                <p class="text-navy mt-2 text-start mx-3 overflow-auto flex-grow-1">
                    @Model.Description
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/prodDetailsFrontImageSwapper.js" asp-append-version="true"></script>
    <script src="~/js/searchFormValidator.js" asp-append-version="true"></script>
    <script src="~/js/prodQtyToAddToOrderValidation.js" asp-append-version="true"></script>
}