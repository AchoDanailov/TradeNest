@model AllOrdersViewModel

<div class="card shadow-sm border-0 rounded-3 mx-auto mb-3 p-1" 
     style="min-width: 350px;max-width: 95%">
    
    <div class="card-body d-flex flex-column">

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold text-navy mb-0">
                Order #@Model.Id.ToString().Substring(0, 8)
            </h6>

            @if (Model.IsSubmitted)
            {
                <span class="badge bg-success">Submitted</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.SubmittedOn))
        {
            <small class="text-muted mb-3">
                Submitted on @Model.SubmittedOn
            </small>
        }

        <hr class="mt-2"/>

        <div class="d-flex flex-column gap-2 flex-grow-1">
            @foreach (var product in Model.OrderProducts)
            {
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">
                            @product.Name
                        </div>
                        <small class="text-muted">
                            Qty: @product.QuantityOrdered × €@product.UnitPrice
                        </small>
                    </div>

                    <div class="fw-bold text-navy">
                        €@product.TotalPrice
                    </div>
                </div>
            }
        </div>

        <hr/>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="fw-semibold">Total:</span>
            <span class="fw-bold fs-5 text-teal">
                €@(Model.TotalPrice?.ToString("f2") ?? "0.00")
            </span>
        </div>

    </div>
</div>
