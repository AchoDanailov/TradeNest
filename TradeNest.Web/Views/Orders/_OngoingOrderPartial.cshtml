@model OrderViewModel

<div class="d-flex flex-column gap-1 p-3 mx-auto" 
     style="max-width: 95%;">
    @foreach (OrderProductViewModel product in this.Model.OrderProducts)
    {
        <div class="card d-flex flex-row p-2 pe-4 shadow site-sections-bg">
            <div class="d-flex flex-column flex-grow-1">
                @if (product.Name.Length > 20)
                {
                    <h5 class="text-navy d-md-none">@product.Name.Substring(0, 15)...</h5>
                    <h5 class="text-navy d-none d-md-block">@product.Name</h5>
                }
                else
                {
                    <h5 class="text-navy d-none d-md-block">@product.Name</h5>
                }
                <p class="mb-0">Quantity: @product.QuantityOrdered</p>
                <p class="mb-0">Unit Price: €@product.UnitPrice</p>
                <p class="mb-0">Total Price: €@product.TotalPrice</p>
            </div>
            <div class="d-flex align-items-center justify-content-between gap-2">
                <a class="btn btn-teal" asp-controller="Products" asp-action="Details"
                   asp-route-id="@product.Id">Details</a>
                <form method="post" asp-controller="Orders" asp-action="RemoveProduct"
                      asp-route-id="@product.Id">
                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Orders")" />
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">Remove</button>
                </form>
            </div>
        </div>
    }
    <div class="d-flex justify-content-end me-2 my-2">
        <h5 class="text-navy">Order Total: €@this.Model.TotalPrice</h5>
    </div>
    <div class="d-flex justify-content-end gap-2 me-2">
        <a type="submit" class="btn btn-teal"
           asp-controller="Products" asp-action="Index">Add More Products</a>
        <button type="submit" class="btn btn-outline-danger"
                data-bs-toggle="modal" data-bs-target="#cancel-order-modal">Cancel Order</button>
        <button type="submit" class="btn btn-success"
                data-bs-toggle="modal" data-bs-target="#submit-order-modal">Submit Order</button>
    </div>
</div>


<div class="modal fade" id="cancel-order-modal" data-bs-backdrop="static"
     data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" 
     aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
          <h1 class="modal-title fs-5" id="staticBackdropLabel">
              Confirmation
          </h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" 
                  aria-label="Close"></button>
      </div>
      <div class="modal-body">
          Are you sure you want to cancel the order?
      </div>
      <div class="modal-footer">
          <button type="button" class="btn btn-secondary" 
                  data-bs-dismiss="modal">No</button>
          <form method="post" asp-controller="Orders"
                asp-action="Cancel" asp-route-id="@Model.Id">
              <input type="hidden" name="returnUrl" 
                     value="@Url.Action("Index", controller: "Orders")"/>
              <button type="submit" class="btn btn-danger">Yes</button>
          </form>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="submit-order-modal" data-bs-backdrop="static"
     data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" 
     aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
          <h1 class="modal-title fs-5" id="staticBackdropLabel">
              Confirm Submit
          </h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" 
                  aria-label="Close"></button>
      </div>
      <div class="modal-body">
          Are you sure you want to submit the order?
      </div>
      <div class="modal-footer">
          <button type="button" class="btn btn-secondary" 
                  data-bs-dismiss="modal">No</button>
          <form method="post" asp-controller="Orders"
                asp-action="Submit" asp-route-id="@Model.Id">
              <input type="hidden" name="returnUrl" 
                     value="@Url.Action("Index", controller: "Orders")"/>
              <button type="submit" class="btn btn-danger">Yes</button>
          </form>
      </div>
    </div>
  </div>
</div>
