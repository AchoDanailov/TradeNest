<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-TradeNest.Web-b54bd82d-7b02-40cc-8d63-534e668de013</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.23" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.23" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="6.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.23" />
    <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" Version="4.3.1" />
  </ItemGroup>

  <Target Name="CompileTypeScript" BeforeTargets="Build">
    <Exec Command="npx tsc -p tsconfig.json" WorkingDirectory="$(ProjectDir)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\TradeNest.Data\TradeNest.Data.csproj" />
    <ProjectReference Include="..\TradeNest.Services.Core\TradeNest.Services.Core.csproj" />
    <ProjectReference Include="..\TradeNest.Web.Infrastructure\TradeNest.Web.Infrastructure.csproj" />
    <ProjectReference Include="..\TradeNest.Web.Models\TradeNest.Web.Models.csproj" />
    <ProjectReference Include="..\TradeNest.GCommon\TradeNest.GCommon.csproj" />
  </ItemGroup>

</Project>
