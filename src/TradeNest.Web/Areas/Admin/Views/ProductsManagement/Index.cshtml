@{
    ViewData["Title"] = "Manage Products";
}

<partial name="_AdminAreaNavigationButtonsPartial"
         model="@(new
                {
                    Next = new
                    {
                        Area = "Admin",
                        Controller = "ProductsManagement",
                        Action = "ManageCategories",
                        ForwardButtonText = "Manage Categories",
                    },
                    ReturnUrl = Url.Action("Index", controller: "Home", new { area = "Admin" })
                })" />

<div class="container-lg d-flex flex-column mt-2 site-sections-bg shadow border-3 rounded-3 pt-4 pb-3">
    <div id="header" class="text-center">
        <h1 class="display-2 text-teal">@ViewData["Title"]</h1>
    </div>

    <div id="controls" class="d-flex flex-column justify-content-center w-75 mx-auto">

    </div>

    <div id="table-container" class="w-100 overflow-auto px-3">

    </div>
</div>

@section Scripts {
    <script src="~/js/products-management/productsManagementMain.js" type="module" asp-append-version="true"></script>
}