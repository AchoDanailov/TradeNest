@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-lg d-flex flex-column gap-5 pt-3 pb-5 mt-5 justify-content-around align-items-center site-sections-bg shadow border-3 rounded-3">
    <div id="header" class="row mb-2 mt-5">
        <div class="col-12 border-bottom border-2">
            <h1 class="text-center text-teal display-1">@ViewData["Title"]</h1>
        </div>
    </div>
    
    <div class="row mx-auto text-center justify-content-lg-between justify-content-center align-items-stretch gap-5 gap-lg-0 mb-5">
        <div id="manage-users"
             class="col-10 col-lg-5 d-flex flex-column gap-2 p-5 site-sections-bg-teal shadow rounded-3 border-3">
            <h3 class="display-6 text-navy mt-1 mb-0 pb-0">Manage Users</h3>
            <p class="text-light fw-light">Delete users, assign roles, remove roles</p>
            
            <a asp-area="Admin" asp-controller="UsersManagement" asp-action="Index"
               class="btn rounded-pill bg-white-border-neon-glow-hover-reverse-colors site-sections-bg p-2 w-25 mx-auto text-black">
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        
        <div id="manage-products"
             class="col-10 col-lg-5 d-flex flex-column gap-2 p-5 site-sections-bg-teal shadow rounded-3">
            <h3 class="display-6 text-navy mb-0 pb-0">Manage Products</h3>
            <p class="text-light fw-light">Approve products, Change products approval status, remove products, add categories</p>
            
            <a asp-area="Admin" asp-controller="ProductsManagement" asp-action="Index"
               class="btn rounded-pill site-sections-bg p-2 w-25 mx-auto text-black bg-white-border-neon-glow-hover-reverse-colors">
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    
    @* <div id="add-category" class="mt-2"> *@
    @*     <button class="btn btn-outline-teal rounded-pill px-5 py-2 fw-bold shadow-sm"> *@
    @*         <i class="bi bi-plus-circle me-2"></i>Add New Category *@
    @*     </button> *@
    @* </div> *@
</div>