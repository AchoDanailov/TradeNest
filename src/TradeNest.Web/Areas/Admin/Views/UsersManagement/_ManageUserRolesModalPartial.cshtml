@model ManageUserRolesFormModel

<div class="modal fade" id="manage-roles" data-bs-backdrop="static" tabindex="-1" aria-labelledby="title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-3 text-teal" id="title">Manage User Roles</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form method="post" asp-area="Admin" asp-controller="UsersManagement" asp-action="ManageUserRoles">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Username" />
                <input type="hidden" asp-for="Email" />
                
                <div class="modal-body mb-0 pb-0">
                    <div class="d-flex justify-content-around mb-4">
                        <p class="text-navy fs-5 mb-1 border-bottom border-2">
                            <span class="text-teal fw-bold">Username:</span> @Model.Username
                        </p>
                        <p class="text-navy fs-5 mb-1 border-bottom border-2">
                            <span class="text-teal fw-bold">Email:</span> @Model.Email
                        </p>
                    </div>

                    <div class="d-flex flex-column justify-content-around pb-2 border-2 border">
                        <div class="row text-center mt-2 mb-0">
                            <p class="col-6 text-teal fs-5">Role</p>
                            <p class="col-6 text-teal fs-5">Action</p>
                        </div>

                        @for (int i = 0; i < this.Model.AllRoles.Count; i++)
                        {
                            <input type="hidden" asp-for="@Model.AllRoles[i].Id" />
                            <input type="hidden" asp-for="@Model.AllRoles[i].RoleName" />
                            <input type="hidden" asp-for="@Model.AllRoles[i].IsAssigned" />

                            <div class="row my-2 align-items-center">
                                <div class="col-6 text-center">
                                    <p class="text-navy mb-0">@Model.AllRoles[i].RoleName</p>
                                </div>

                                @{ bool isAssigned = this.Model.AllRoles[i].IsAssigned; }
                                @if (isAssigned)
                                {
                                    string inputElId = $"remove-{this.Model.AllRoles[i].RoleName}";

                                    <div class="col-6 text-center">
                                        <input type="checkbox" class="btn-check"
                                               asp-for="@Model.AllRoles[i].IsActionTaken" id="@inputElId"/>
                                        <label class="btn btn-sm btn-outline-danger" for="@inputElId">
                                            Remove @Model.AllRoles[i].RoleName role
                                        </label>
                                    </div>
                                }
                                else
                                {
                                    string inputElId = $"assign-{this.Model.AllRoles[i].RoleName}";

                                    <div class="col-6 text-center">
                                        <input type="checkbox" class="btn-check" id="@inputElId"
                                               asp-for="@Model.AllRoles[i].IsActionTaken"/>
                                        <label class="btn btn-sm btn-outline-success" for="@inputElId">
                                            Assign @Model.AllRoles[i].RoleName role
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer px-4 mt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-teal">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>