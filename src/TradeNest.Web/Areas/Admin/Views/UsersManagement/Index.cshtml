@model ManageAllUsersViewModel

@{
    ViewData["Title"] = "Manage Users";
    string hoverEffect = "nav-link-border-radius-hover-effect-light";
}

<div>
    <div class="mt-2 container-lg">
        <partial name="_StatusNotificationPartial"/>
    </div>

    <div class="container-lg d-flex justify-content-between mt-4 px-0 px-sm-4" id="nav-buttons-wrapper">
        <div class="pt-2 pt-md-3">
            <partial name="_BackButtonPartial" model="@Model.ReturnUrl"/>
        </div>

        <div id="manage-roles" class="mt-2">
            <a asp-area="Admin" asp-controller="UsersManagement" asp-action="ManageAllRoles"
               class="btn btn-outline-teal rounded-pill px-5 py-2 fw-bold shadow-sm">
                Manage All Roles →
            </a>
        </div>
    </div>
</div>

<div class="container-lg d-flex flex-column mt-2 gap-5 site-sections-bg shadow border-3 rounded-3 pt-4 pb-5">
    <div id="header" class="border-2 border-bottom">
        <h1 class="display-2 text-teal ms-2 mb-0 pb-0">@ViewData["Title"]</h1>
    </div>
    
    <div id="table-section">
        <div id="table-wrapper">
            <table class="table table-hover caption-top">
                <caption>List of Users</caption>
                <thead class="site-sections-bg-teal text-center">
                    <tr>
                        <th class="@hoverEffect">Username</th>
                        <th class="@hoverEffect">Email</th>
                        <th class="@hoverEffect">Role</th>
                        <th class="@hoverEffect">Actions</th>
                    </tr>
                </thead>
                <tbody class="tbody-top-border">
                    @foreach (ManageUserViewModel user in this.Model.Users)
                    {
                        bool isAdmin = user.UserRoles.Any(r => r.RoleName == "Admin");
                        
                        <tr class="text-center">
                            <td>@user.Username</td>
                            <td>@user.Email</td>
                            <td>@string.Join(", ", user.UserRoles.Select(r => r.RoleName))</td>
                            
                            @if (isAdmin)
                            {
                                <td class="text-muted text-center">No actions available</td>
                            }
                            else
                            {
                                <td class="text-center">
                                    <div class="btn-group-sm d-flex flex-wrap justify-content-center gap-1 gap-sm-2 gap-md-3">
                                        
                                        @{ string manageRolesModalId = $"#manage-roles-{user.Id}"; }
                                        <button class="btn rounded-pill btn-outline-teal btn-sm"
                                                 data-bs-toggle="modal" data-bs-target="@manageRolesModalId">
                                            Manage Roles
                                        </button>

                                        @{ string deleteModalId = $"#delete-modal-{user.Id}"; }
                                        <button class="btn rounded-pill btn-outline-danger btn-sm"
                                                data-bs-toggle="modal" data-bs-target="@deleteModalId">
                                            Remove User
                                        </button>
                                        
                                    </div>
                                </td>
                                
                                <partial name="_RemoveUserModalPartial" model="@user" />

                                <partial name="_ManageUserRolesModalPartial"
                                         model="@(new ManageUserRolesFormModel()
                                                {
                                                    Id = user.Id,
                                                    Username = user.Username,
                                                    Email = user.Email,

                                                    ReturnUrl = Context.Request.Path,
                                                    AllRoles = this.Model.AllRoles
                                                        .Select(role => new AssignRoleFormModel()
                                                        {
                                                            Id = role.Id,
                                                            RoleName = role.RoleName,
                                                            IsAssigned = user.UserRoles.Any(userRole => userRole.Id == role.Id),
                                                            IsActionTaken = false,
                                                        })
                                                        .ToList()
                                                })" />
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>