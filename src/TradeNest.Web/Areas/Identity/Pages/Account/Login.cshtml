@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container-lg site-sections-bg px-1 px-md-5 py-5 mt-5 d-flex justify-content-center flex-column shadow rounded">
    <h1 class="text-navy">@ViewData["Title"]</h1>
    <div class="row">
        <div class="col-md-5">
            <section>
                <form id="account" method="post">
                    <h2 class="text-teal">Use a local account to log in.</h2>
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.UserNameOrEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.UserNameOrEmail" class="form-label">Username or Email</label>
                        <span asp-validation-for="Input.UserNameOrEmail" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="checkbox mb-3">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-teal mb-3">Log in</button>
                    </div>
                </form>
            </section>
            
            <small>
                Don’t have an account?
                <a asp-area="Identity" asp-page="/Account/Register" 
                   class="text-decoration-underline">
                    Register here
                </a>
            </small>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
