@model CartWithOrdersViewModel
@{
    ViewData["Title"] = "Cart";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
}

<div class="mt-3 d-md-none">
    <partial name="_SearchFormPartial" model="@string.Empty" />
</div>

<div class="container-lg mt-4 p-3 border rounded-3 shadow site-sections-bg d-flex flex-column gap-3">

    <partial name="_StatusNotificationPartial" />

    <div class="row">
        <div class="d-none d-md-flex justify-content-center">
            <partial name="_SearchFormPartial" model="@string.Empty" />
        </div>
    </div>

    <div class="row d-flex flex-column">
        <div>
            <h5 class="display-5 text-navy ms-md-3">Cart</h5>
            <hr class="mt-0" />
        </div>
        @if (this.Model.CartViewModel != null)
        {
            <partial name="_CartPartial" model="@Model.CartViewModel"/>
        }
        else
        {
            <div class="d-flex flex-column col mt-3 mt-md-4">
                <h4 class="text-navy text-center mx-auto w-75">
                    You currently have no products in your cart.
                </h4>
                <a class="btn btn-teal mx-auto"
                   asp-area="" asp-controller="Products" asp-action="Index">
                    Browse the catalog and add products to your cart.
                </a>
            </div>
        }
    </div>

    <div class="row d-flex flex-column mt-4">
        <div>
            <h5 class="display-5 text-navy ms-md-3">Orders History</h5>
        </div>
        @if (this.Model.OrderViewModels.Any())
        {
            <div class="d-flex flex-wrap gap-3 justify-content-around mt-2">
                @foreach (OrderViewModel order in this.Model.OrderViewModels)
                {
                    <partial name="_OrderCardPartial" model="order"/>
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-column">
                <h4 class="text-navy text-muted text-center mx-auto my-3 w-75">
                    No history of old orders found.
                </h4>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script src="~/js/utils/searchFormValidator.js" asp-append-version="true"></script>
    <script type="module" src="~/js/cart/changeCartProductQtyPopover.js" asp-append-version="true"></script>
}