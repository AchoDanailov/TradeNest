@model CartViewModel

<div class="d-flex flex-column gap-1 p-3 mx-auto cart-container">
    @foreach (CartProductViewModel product in this.Model.CartProducts)
    {
        ICollection<string> warnings = new List<string>();
        if (!product.IsEnabled)
        {
            warnings.Add("Disabled");
        }
        if (!product.IsEnoughQtyLeft)
        {
            warnings.Add("Not enough quantity available");
        }
        
        bool canBuy = product.IsEnabled && product.IsEnoughQtyLeft;
        
        <div class="card d-flex flex-column p-2 pe-4 shadow site-sections-bg rounded-3 flex-row cart-product
            @(canBuy ? "cart-product-enabled" : "cart-product-disabled")">
            @if(warnings.Any())
            {
                <p class="text-danger fw-bold mb-0 pb-0">@string.Join(" | ", warnings)</p>
                <p class="text-danger fw-bold mb-1 pt-0 mt-0">
                    Please review the details and take necessary action.
                </p>
            }
            
            <div class="d-flex flex-row">
                <div class="d-flex flex-column flex-grow-1">
                    @if (product.Name.Length > 20)
                    {
                        <h5 class="text-navy d-sm-none">@product.Name.Substring(0, 15)...</h5>
                        <h5 class="text-navy d-none d-sm-block">@product.Name</h5>
                    }
                    else
                    {
                        <h5 class="text-navy d-none d-md-block">@product.Name</h5>
                    }

                    <p class="mb-0 quantity-already-added">Quantity: @product.QuantityAdded</p>
                    <p class="mb-0">Unit Price: €@product.UnitPrice.ToString(PricesFormat)</p>
                    <p class="mb-0">Total Price: €@product.TotalPrice.ToString(PricesFormat)</p>
                </div>
                
                <div class="d-flex gap-2 flex-wrap 
                        @(canBuy 
                            ? "align-items-center" 
                            : "flex-column align-items-center justify-content-start mt-2")">

                    <div class="d-flex gap-2">
                        <a class="btn btn-teal"
                           asp-controller="Products" asp-action="Details"
                           asp-route-id="@product.Id"
                           asp-route-returnUrl="@Url.Action("Index", controller: "Cart")">
                            Details
                        </a>

                        <form method="post" asp-controller="Cart" asp-action="RemoveFromCart"
                              asp-route-id="@product.Id">
                            <button type="submit" class="btn btn-danger">
                                Remove
                            </button>
                        </form>
                    </div>
                    
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" 
                       asp-route-returnUrl="@Url.Action(nameof(Index), controller: "Cart")"
                       class="btn btn-success change-qty-button" data-product-id="@product.Id" 
                       data-cart-id="@Model.CartId">
                       Change Quantity
                    </a>

                </div>
            </div>
        </div>
    }
    
    <div class="d-flex justify-content-end me-2 my-2">
        <h5 class="text-navy">Total: €@this.Model.TotalPrice.ToString(PricesFormat)</h5>
    </div>
    
    <div class="d-flex justify-content-end gap-2 me-2">
        <a class="btn btn-teal" asp-controller="Products" asp-action="Index">
            Add More Products
        </a>
        
        <button type="button" class="btn btn-outline-danger"
                data-bs-toggle="modal" data-bs-target="#cancel-order-modal">Delete Cart</button>
        
        <button type="button" class="btn btn-success"
                data-bs-toggle="modal" data-bs-target="#submit-order-modal">Order Cart Items</button>
    </div>
</div>


<div class="modal fade" id="cancel-order-modal" data-bs-backdrop="static"
     data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" 
     aria-hidden="true">
  <div class="modal-dialog">
      <div class="modal-content">
          
          <div class="modal-header">
              <h1 class="modal-title fs-5" id="staticBackdropLabel">
                  Confirmation
              </h1>
              <button type="button" class="btn-close" data-bs-dismiss="modal"
                      aria-label="Close"></button>
          </div>
          
          <div class="modal-body">
              Are you sure you want to delete this cart.
          </div>
          
          <div class="modal-footer">
              <button type="button" class="btn btn-secondary"
                      data-bs-dismiss="modal">No</button>
              
              <form method="post" asp-controller="Cart"
                    asp-action="Cancel">
                  <button type="submit" class="btn btn-danger">Yes</button>
              </form>
          </div>
      </div>
  </div>
</div>

<div class="modal fade" id="submit-order-modal" data-bs-backdrop="static"
     data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" 
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
          
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">
                    Confirm Order
                </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
          
            <div class="modal-body">
                Are you sure you want to make the order?
            </div>
          
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">No</button>
              
                <form method="post" asp-controller="Cart" asp-action="SubmitOrder">
                    <button type="submit" class="btn btn-teal">Yes</button>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_ChangeCartProdQtyPopoverPartial" />
