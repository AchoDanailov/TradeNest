@model IEnumerable<AllCategoriesWithBestSellerFrontImageViewModel>
@{
    ViewData["Title"] = "Categories";
}


<div class="mt-3 d-md-none">
    <partial name="_SearchFormPartial" model="@string.Empty" />
</div>   

<div class="container-lg mb-5 mt-3 pt-4 site-sections-bg rounded-3 border shadow">
    
    <div class="row d-none d-md-flex">
        <div class="col-md-5 text-md-start ms-md-2">
            <h2 class="display-3 text-teal mb-0">@ViewData["Title"]</h2>
        </div>
        
        <div class="d-none d-md-flex col-md-6 mt-md-0 justify-content-md-start">
            <partial name="_SearchFormPartial" model="@string.Empty" />
        </div>
    </div>
    
    <div class="row d-flex d-md-none">
        <div class="col text-center">
            <h2 class="display-3 text-teal">@ViewData["Title"]</h2>
        </div>
    </div>
    <hr class="mb-5"/>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-2 justify-content-center pb-4">
        @foreach (AllCategoriesWithBestSellerFrontImageViewModel category in this.Model)
        {
            <div class="col d-flex justify-content-center">
                <div class="categories-card card shadow-sm border rounded-3 text-center d-flex flex-column justify-content-center align-items-center py-2">
                    
                    <div class="category-image-wrapper">
                        <img src="@category.BestSellerImageUrl"
                             alt="@category.CategoryName"
                             class="category-img card-img-top" />
                    </div>

                    <div class="card-body">
                        <h5 class="card-title text-teal">@category.CategoryName</h5>
                        <a class="btn btn-teal w-100"
                           asp-controller="Products" asp-action="Index"
                           asp-route-categoryId="@category.Id">
                            View All @category.CategoryName
                        </a>
                    </div>
                    
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/searchFormValidator.js" asp-append-version="true"></script>
}