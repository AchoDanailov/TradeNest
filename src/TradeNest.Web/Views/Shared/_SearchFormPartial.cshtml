@model string?

@{
    string searchInputFieldValue = string.IsNullOrWhiteSpace(this.Model) 
        ? string.Empty 
        : this.Model;
}

<div class="d-flex flex-column align-items-center">
    <label for="searchInput" class="form-label text-navy text-center">
        Search for everything
    </label>
    <form method="get" asp-area="" asp-controller="Products" asp-action="Index" id="searchForm">
        <div class="input-group">
            <input name="search" type="search" id="searchInput"
                   class="form-control" placeholder="Search..." 
                   aria-label="Search" value="@searchInputFieldValue" />
            <button class="btn btn-outline-teal" type="submit">Search</button>
        </div>
    </form>
</div>