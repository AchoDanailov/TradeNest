@model string
@{
    string PickReturnBackText(string returnUrl)
    {
        if (returnUrl.ToLowerInvariant().Contains("products") ||
            returnUrl.ToLowerInvariant().Contains("catalog"))
        {
            if (returnUrl.ToLowerInvariant().Contains("details"))
                return "Back To Details";
            
            if (returnUrl.ToLowerInvariant().Contains("management"))
                return "Back To Products Management";
            
            return "Back To Catalog";
        }
        else if (returnUrl.ToLowerInvariant().Contains("cart"))
        {
            return "Back To Cart";
        }
        else if (returnUrl.ToLowerInvariant().Contains("usersmanagement"))
        {
            return "Back To Users Management";
        }
        else
        {
            return "Go Back";
        }
    }
    
    string returnBackText = PickReturnBackText(this.Model);
}

<div class="d-flex justify-content-end">
    <a href="@Model" class="btn btn-outline-teal rounded-pill px-4 py2 fw-bold shadow-sm">
         ← @returnBackText
    </a>
</div>
