@model CatalogViewModel
@{
    ViewData["Title"] = "Catalog";
    TempData["CategoryFilter"] = this.Model.CategoryFilter;
    TempData["SearchFilter"] = this.Model.SearchFilter;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
}

<div class="container-lg py-3">

    <partial name="_StatusNotificationPartial" />

    <div class="row d-flex flex-row my-2">
        <div class="text-center d-flex justify-content-center justify-content-md-start ms-md-2 col-md-4">
            <a asp-area="" asp-controller="Products" asp-action="Index">
                <h2 class="display-2 text-teal">@ViewData["Title"]</h2>
            </a>
        </div>

        <div class="col-5 d-md-none d-flex flex-column align-items-start gap-2">

            @if (Model.CategoryFilter != null && Model.CategoryFilter.Value != Guid.Empty)
            {
                <div class="ms-1 d-md-none">
                    <a asp-area="" asp-controller="Products" asp-action="Index"
                       asp-route-categoryId="@Guid.Empty"
                       class="small text-muted">
                        <span class="border-bottom">
                            <span class="btn-sm btn-danger">x</span> clear category filter
                        </span>
                    </a>
                </div>
            }
            <div class="btn-group" style="max-width: 142px; min-width: 142px">
                <a class="btn btn-teal">@(Model.Categories.SingleOrDefault(c =>
                                            c.Id == Model.CategoryFilter)?.CategoryName ?? "All Categories")</a>
                <button type="button"
                        class="btn btn-teal dropdown-toggle dropdown-toggle-split"
                        data-bs-toggle="dropdown" aria-expanded="false"></button>

                <ul class="dropdown-menu shadow">
                    @foreach (AllCategoriesViewModel category in this.Model.Categories)
                    {
                        if (Model.CategoryFilter != null &&
                            Model.CategoryFilter.Value != Guid.Empty &&
                            category.Id == Model.CategoryFilter.Value)
                        {
                            continue;
                        }

                        <li class="nav-item">
                            <a asp-area="" asp-controller="Products" asp-action="Index"
                               asp-route-categoryId="@category.Id" class="dropdown-item">
                                @category.CategoryName
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div>
                <a asp-controller="Products" asp-action="Create"
                   asp-route-returnUrl="@Context.Request.Path"
                   class="btn btn-teal mt-0">Add A New Product</a>
            </div>

        </div>

        <div class="col mt-2 mt-md-0 text-center gap-2">
            <partial name="_SearchFormPartial" model="@Model.SearchFilter"/>
            @if (this.Model.SearchFilter != null)
            {
                <div class="my-2">
                    <span>results for: @Model.SearchFilter</span>
                    <a asp-area="" asp-controller="Products" asp-action="Index" asp-route-search="clear">
                        <span class="btn-sm btn-danger">x</span>
                    </a>
                </div>
            }
        </div>

        <div class="d-none d-md-flex col-md-3 me-3 align-items-center justify-content-end">
            <a asp-controller="Products" asp-action="Create"
               asp-route-returnUrl="@Context.Request.Path"
               class="btn btn-teal">Add A New Product</a>
        </div>
    </div>

    <div class="row d-flex gap-1">

        <div class="col-md-3 col-xl-2 nav navbar navbar-nav-scroll d-none d-md-flex site-sections-bg border rounded-3 shadow justify-content-center align-content-start flex-grow-0">

            @if (Model.CategoryFilter != null && Model.CategoryFilter.Value != Guid.Empty)
            {
                <div class="text-center mb-4">
                    <a asp-area="" asp-controller="Products" asp-action="Index"
                       asp-route-categoryId="@Guid.Empty"
                       class="small text-muted">
                        <span class="border-bottom">
                            <span class="btn-sm btn-danger">x</span> clear category filter
                        </span>
                    </a>
                </div>
            }

            <h5 class="text-navy pb-1 border-bottom nav">All Categories</h5>

            <ul class="d-flex flex-column justify-content-center text-center gap-1 mb-2">
                @foreach (AllCategoriesViewModel category in this.Model.Categories)
                {
                    if (Model.CategoryFilter != null &&
                        Model.CategoryFilter.Value != Guid.Empty &&
                        category.Id == Model.CategoryFilter.Value)
                    {
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Products" asp-action="Index"
                               asp-route-categoryId="@category.Id"
                               class="nav-link nav-link-border-radius-hover-effect-light selected">
                                @category.CategoryName
                            </a>
                        </li>

                        continue;
                    }

                    <li class="nav-item">
                        <a asp-area="" asp-controller="Products" asp-action="Index"
                           asp-route-categoryId="@category.Id"
                           class="nav-link nav-link-border-radius-hover-effect-light">
                            @category.CategoryName
                        </a>
                    </li>
                }
            </ul>
        </div>

        <div class="col d-flex flex-column gap-1 products-container">
            @if (!this.Model.Products.Any())
            {
                if (this.Model.SearchFilter == null)
                {
                    <div class="row p-5 site-sections-bg shadow rounded-3 d-flex justify-content-center gap-2">
                        @if (this.Model.CategoryFilter == null)
                        {
                            <h4 class="text-navy display-4 text-center">
                                No products are available at the moment
                            </h4>
                        }
                        else
                        {
                            <h4 class="text-navy display-4 text-center">
                                No products are available at the moment in this category.
                            </h4>
                        }

                        <a class="btn btn-teal btn-lg px-4 mx-auto w-auto"
                           asp-controller="Products" asp-action="Create">
                            Be The First To Sell Your Products
                        </a>
                    </div>
                }
                else
                {
                    <div class="row p-5 site-sections-bg shadow rounded-3 d-flex justify-content-center gap-2">
                        <h4 class="text-navy display-4 text-center">No matches found</h4>
                    </div>
                }
            }
            else
            {
                @foreach (ProductViewModel product in this.Model.Products)
                {
                    <partial name="_ProductCardPartial" model="@product"/>
                }
            }
        </div>
    </div>
</div>

<partial name="_ChoseQtyPopoverPartial" />

@section Scripts {
    <script src="~/js/utils/searchFormValidator.js" asp-append-version="true"></script>
    <script type="module" src="~/js/catalog/chooseProdQtyToAddPopover.js" asp-append-version="true"></script>
}