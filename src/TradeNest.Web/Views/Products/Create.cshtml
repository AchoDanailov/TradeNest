@model ProductCreateFormModel
@{
    ViewData["Title"] = "Add A New Product";
}

<div class="container-lg pb-4 pt-2">
    
    <partial name="_StatusNotificationPartial" />
    
    <div class="d-md-none mb-1">
        <partial name="_BackButtonPartial" model="@Model.ReturnUrl" />
    </div>
    
    <div class="row mx-3 mb-5 px-4 pb-4">
        
        <div class="d-none d-md-block">
            <partial name="_BackButtonPartial" model="@Model.ReturnUrl" />
        </div>
        
        <h1 class="display-5 text-teal text-center text-md-start fw-bold mb-2">
            @ViewData["Title"]
        </h1>
        
        <form asp-controller="Products" asp-action="Create" method="post"
              class="d-flex flex-column gap-4 site-sections-bg p-2 p-md-5 rounded-3 shadow border">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div>
                <label asp-for="@Model.ProductName"
                       class="form-label text-navy fw-bold">Product Name: </label>
                <input type="text" asp-for="@Model.ProductName" 
                       class="form-control" aria-required="true"/>
                <span asp-validation-for="@Model.ProductName" class="text-danger"></span>
            </div>
            
            <div>
                <label asp-for="@Model.SellingPrice"
                       class="form-label text-navy fw-bold">Selling Price: </label>
                <div class="input-group">
                    <span class="input-group-text">€</span>
                    <input type="number" asp-for="@Model.SellingPrice" 
                           class="form-control" aria-required="true"/>
                </div>
                <span asp-validation-for="@Model.SellingPrice" class="text-danger"></span>
            </div>
            
            <div>
                <label asp-for="@Model.CostPrice" class="form-label text-navy fw-bold">
                    Cost Price: <span class="fw-lighter text-muted">(optional)</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text">€</span>
                    <input type="number" asp-for="@Model.CostPrice" 
                           class="form-control" aria-required="true"/>
                </div>
                <span asp-validation-for="@Model.CostPrice" class="text-danger"></span>
            </div>
            
            <div class="g-0">
                <div>
                    <label asp-for="@Model.CategoryId"
                           class="form-label text-navy fw-bold">Category: </label>
                    <select asp-for="@Model.CategoryId" class="form-select">
                        <option value="" selected="selected">-- Select Category --</option>
                        @foreach (AllCategoriesViewModel category in this.Model.AllCategories)
                        {
                            <option value="@category.Id">@category.CategoryName</option>
                        }
                    </select>
                </div>
                <span asp-validation-for="@Model.CategoryId" class="text-danger"></span>
            </div>
            
            <div class="row mb-1 mb-md-0 mt-2 align-items-center mx-auto">
                <div class="col-12 col-md-6">
                    <div class="form-check form-switch">
                        <input asp-for="IsEnabled" class="form-check-input" type="checkbox" />
                        <label asp-for="IsEnabled" class="form-check-label text-navy fw-bold">
                            Is the product up for sale?
                        </label>
                    </div>
                </div>
                
                <div class="col-12 col-md-6">
                    <div class="d-flex align-items-center gap-2">
                        <label asp-for="QuantityInStock" class="form-label text-navy mb-0">
                            Quantity:
                        </label>
                        <input asp-for="QuantityInStock" type="number"
                               class="form-control form-control-sm w-auto" value="1"/>
                    </div>
                    <span asp-validation-for="@Model.QuantityInStock" class="text-danger"></span>
                </div>
            </div>
            
            <div class="g-0">
                <div>
                    <label asp-for="@Model.Description"
                           class="form-label text-navy fw-bold">Description: </label>
                    <textarea asp-for="@Model.Description" class="form-control" 
                            aria-required="true" rows="5"></textarea>
                </div>
                <span asp-validation-for="@Model.Description" class="text-danger"></span>
            </div>
            
            <div class="g-0">
                <div>
                    <label asp-for="@Model.FrontImageUrl" class="form-label text-navy fw-bold">
                        Front Image Url: <span class="fw-lighter text-muted">(optional)</span>
                    </label>
                    <input type="url" asp-for="@Model.FrontImageUrl" class="form-control" 
                           aria-required="true" />
                </div>
                <span asp-validation-for="@Model.FrontImageUrl" class="text-danger"></span>
            </div>
            
            <div>
                <label asp-for="@Model.ExtraImagesUrls" class="form-label text-navy fw-bold">
                    Add extra images: <span class="fw-lighter text-muted">(optional)</span>
                </label>
                <textarea asp-for="@Model.ExtraImagesUrls" class="form-control" 
                    aria-required="true" rows="5"
                    placeholder="Add your extra images urls - each image url on a new line">
                </textarea>
            </div>
            <span asp-validation-for="@Model.ExtraImagesUrls" class="text-danger"></span>
            
            <div class="btn-group-lg mt-3 d-flex justify-content-end gap-3 mb-3 mb-md-0">
                <a asp-controller="Products" asp-action="Index"
                   class="btn-lg rounded-pill btn-secondary p-2">Cancel</a>
                <button type="submit" class="btn-lg rounded-pill btn-teal p-2">Submit</button>
            </div>
            
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}